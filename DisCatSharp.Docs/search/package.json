{
  "name": "@discatsharp/docs-search",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "types": "wrangler types worker-configuration.d.ts",
    "types:check": "wrangler types --check worker-configuration.d.ts",
    "test": "vitest run",
    "dev": "wrangler dev --local",
    "local": "tsx scripts/local-preview.ts",
    "sync:local": "tsx scripts/sync-local.ts",
    "smoke:local": "tsx scripts/smoke-local.ts",
    "smoke:production": "tsx scripts/smoke-production.ts",
    "smoke:workers-dev": "tsx scripts/smoke-workers-dev.ts",
    "prepare:production": "tsx scripts/prepare-production-config.ts",
    "deploy": "wrangler deploy --config wrangler.production.json --minify",
    "deploy:dry": "wrangler deploy --dry-run --outdir dist",
    "migrate:local": "wrangler d1 migrations apply discatsharp-docs-search --local",
    "migrate:remote": "wrangler d1 migrations apply discatsharp-docs-search --remote --config wrangler.production.json",
    "sync": "tsx scripts/sync-index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "0.20.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "jsdom": "26.1.0",
    "miniflare": "5.20260801.1-alpha",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "wrangler": "4.120.0"
  },
  "engines": {
    "node": ">=22.18"
  }
}
